# Claude Code служебные файлы
.claude/

# Секреты и конфиг с ключами — НИКОГДА не загружать в git!
.env
*.env
Live_Bot/.env

# Данные бота вне кода (BOT_DATA_DIR): .env, БД, журналы, state — НИКОГДА в git!
bot_data/

# Платформенная БД (пользователи, ЗАШИФРОВАННЫЕ API-ключи, подписки) — НИКОГДА в git!
*.db
*.db-wal
*.db-shm
Live_Bot/platform.db

# Состояние бота (пересоздаётся при запуске)
Live_Bot/cooldown_state.json
Live_Bot/positions_state.json
Live_Bot/pending_orders.json
Live_Bot/pair_strategy.json
Live_Bot/runtime_settings.json
Live_Bot/state/

# Фантомный счёт: состояние и журнал сделок — данные, а не код
Live_Bot/paper_state.json
Live_Bot/paper_trades.csv
Live_Bot/paper_trades.jsonl
Live_Bot/paper_*.bak
Live_Bot/*.bak

# Профиль браузера окна приложения (создаётся при первом запуске, ~200 МБ)
Live_Bot/app_window/

# Журналы и торговая история
Live_Bot/trades_journal.csv
Live_Bot/trades_detail.jsonl
trades.csv
Live_Bot/trades.csv
Live_Bot/*.log
service_*.log
logs/
*.log

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Виртуальное окружение
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# research/ — кэш и результаты бэктестов (большие/генерируемые, живут внутри research/)
# Кэши свечей качаются скриптами fetch_*: 100-300 МБ на период, в git им не место.
#
# ШАБЛОН, А НЕ СПИСОК ИМЁН — И ЭТО ИСПРАВЛЕНИЕ, А НЕ УКРАШЕНИЕ. Пока правила
# перечисляли периоды поимённо, добавленные позже backtest_cache_mid1 и mid2
# под них не попали и уехали в историю: 218 МБ пикклов, отслеживаемых вопреки
# правилу, стоящему строкой выше. Шаблон закрывает и те периоды, которых ещё
# нет. Сюда же попадает подпапка open_interest/ — история открытого интереса
# качается тем же способом и так же восстановима.
backtest_cache*/
backtest_*.csv
missed_window_report.csv
exp_*.json
tp1_sensitivity_sweep.csv
bot_log.txt
Live_Bot/bot_log.txt

# Временные файлы
*.tmp
*.bak
~$*

# Состояние обновления (какая версия стояла до последнего git pull)
Live_Bot/update_state.json

# Собранная папка для сервера (создаётся make_release.py)
release/
kraken-bot.zip

# Журнал ошибок (данные, не код)
Live_Bot/errors.json

# Версия сборки: создаётся сборщиком из git-тега, в репозитории ей делать
# нечего — иначе она разъедется с настоящим тегом и приложение станет
# сравнивать себя не с тем.
Live_Bot/VERSION

# Результаты сборки приложения
dist/
build/

# Собранные данные о позиционировании: это НАКОПЛЕННЫЕ наблюдения, а не код.
# Растут каждый час и у каждой установки свои — в репозитории им не место.
Live_Bot/positioning/
polymarket_cache/
# Накопленные снимки цен Polymarket и обученная поправка по станциям: это
# НАБЛЮДЕНИЯ, а не код. История цен у площадки живёт 30-40 суток, поэтому ряд
# копится своими силами и растёт вечно; у каждой установки он свой.
Live_Bot/polymarket_data/

# Выгрузки, сохранённые по кнопке: данные, а не код.
Live_Bot/exports/

# Состояние запущенного приложения и отладочные выгрузки. Пишутся на ходу и в
# истории кода не нужны: running_app.json меняется при каждом запуске,
# window.json — при каждом движении окна, а leak_trace.txt был разовой
# выгрузкой трассировок из разбора «кто пишет в боевой paper_state.json».
Live_Bot/running_app.json
Live_Bot/window.json
Live_Bot/leak_trace.txt
