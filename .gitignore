Live_Bot/paper_trades.csv
Live_Bot/paper_trades.jsonl
Live_Bot/paper_*.bak
Live_Bot/*.bak

# Профиль браузера окна приложения (создаётся при первом запуске, ~200 МБ)
Live_Bot/app_window/

