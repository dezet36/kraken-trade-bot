# Claude Code служебные файлы
.claude/

# Секреты и конфиг с ключами — НИКОГДА не загружать в git!
.env
*.env
Live_Bot/.env

# Данные бота вне кода (BOT_DATA_DIR): .env, БД, журналы, state — НИКОГДА в git!
bot_data/

# Платформенная БД (пользователи, ЗАШИФРОВАННЫЕ API-ключи, подписки) — НИКОГДА в git!
*.db
*.db-wal
*.db-shm
Live_Bot/platform.db

# Состояние бота (пересоздаётся при запуске)
