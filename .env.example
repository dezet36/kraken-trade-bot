# ═══════════════════════════════════════════════════════════════════════════
#  Настройки бота. Скопируйте этот файл в bot_data/.env и заполните.
#
#  Файл лежит в bot_data/ — каталоге ДАННЫХ, отдельном от кода. Обновление
#  кода его не трогает: git этот каталог не видит, копирование новой версии
#  папки поверх старой его не заденет.
# ═══════════════════════════════════════════════════════════════════════════

# ── Обязательное ───────────────────────────────────────────────────────────

# PAPER — фантом: сделки считаются, но на биржу не отправляются. Начните с него.
# DEMO  — демо-счёт биржи (api-demo.bybit.com), настоящие ордера, ненастоящие деньги.
# LIVE  — реальные деньги. Требует подтверждения с клавиатуры при запуске.
TRADING_MODE=PAPER

# Разрешить LIVE при запуске службой. С клавиатуры LIVE подтверждается дважды,
# но у службы клавиатуры нет — без этой строки она откажется стартовать в LIVE.
# Вписывать осознанно: это и есть подтверждение.
# LIVE_CONFIRMED=YES

# bybit | bingx
EXCHANGE=bybit

# Ключи. Нужны даже в режиме PAPER: котировки берутся с биржи.
# Для PAPER и DEMO подойдут ключи демо-счёта.
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# ── Стратегии ──────────────────────────────────────────────────────────────

# FIBO | SMC | LEVELS | BOTH. BOTH — все три торгуют одновременно, каждая со
# своим депозитом и своими слотами; так их можно честно сравнить на одних
# свечах. Имя BOTH осталось с тех пор, когда стратегий было две.
STRATEGY=BOTH

# Стартовый депозит каждой стратегии в фантоме, USDT.
PAPER_START_BALANCE=10000

# ── Риск ───────────────────────────────────────────────────────────────────

# Доля депозита, теряемая при срабатывании стопа. 0.5-1% — обычный диапазон.
RISK_PER_TRADE=0.5

# Максимум одновременных позиций. Меняется с дашборда для каждой стратегии
# отдельно; здесь — значение при первом запуске.
MAX_ACTIVE_PAIRS=5

# Условный баланс для расчёта объёма, если биржа его не отдаёт.
BALANCE=10000

# ── Уведомления (необязательно) ────────────────────────────────────────────

# Без них бот работает, но о сделках не сообщает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Дашборд ────────────────────────────────────────────────────────────────

DASHBOARD_PORT=8787

# По умолчанию дашборд слушает только эту машину, и управление разрешено
# только с неё. Если открываете его наружу — ставьте обратный прокси с
# паролем и HTTPS. Страница не имеет ни того, ни другого.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_ALLOW_CONTROL=false

# ─────────────────────────────────────────────────────────────────────────────
# POLYMARKET: маркет-мейкинг
# ─────────────────────────────────────────────────────────────────────────────
# КЛЮЧ ЧИТАЕТСЯ ТОЛЬКО ОТСЮДА. Через панель он не принимается намеренно: панель
# слушает без пароля, и всё, что через неё прошло, оседает в файле настроек,
# который она же отдаёт по /api/settings. Ключ, побывавший там, придётся
# считать скомпрометированным.
#
# ПРИВАТНЫЙ КЛЮЧ БЛОКЧЕЙНА — НЕ ПАРОЛЬ. Его нельзя сменить или отозвать: кто им
# владеет, тот распоряжается средствами. Заведите ОТДЕЛЬНЫЙ торговый кошелёк с
# суммой, потеря которой ничего не решает, и не связывайте его с основными
# средствами.
PM_PRIVATE_KEY=
# Адрес счёта Polymarket. У кошелька, созданного через email, он ОТЛИЧАЕТСЯ от
# адреса ключа: деньги лежат на прокси-контракте. Посмотреть можно в профиле на
# сайте. Указав вместо него адрес ключа, получите пустой баланс и отказы.
PM_FUNDER=
# Тип подписи: 0 — ключ напрямую, 1 — кошелёк Polymarket через email/Magic,
# 2 — кошелёк из браузерного расширения. Ошибка здесь выглядит как «заявки
# отвергаются без причины».
PM_SIGNATURE_TYPE=1

# ЖИВАЯ ТОРГОВЛЯ ВЫКЛЮЧЕНА. Наличия ключа НЕДОСТАТОЧНО — нужен ещё и этот флаг.
# Так сделано потому, что ключ появляется в окружении задолго до готовности
# торговать: при настройке, при проверке подключения. Включайте, только когда
# бумажный прогон дал основания.
PM_LIVE=0
# Потолок одной заявки в долларах и предел частоты. Проверяются в исполнителе,
# то есть последними, — там, где деньги уходят.
PM_MAX_ORDER_USD=25
PM_MAX_ORDERS_PER_MINUTE=60
# Капитал маркет-мейкера и потолки запаса.
PM_BANKROLL=1000
PM_MAX_POSITION=300
PM_MAX_EXPOSURE_USD=500
# Сколько рынков держим одновременно.
PM_MARKETS=120

# Автозапуск маркет-мейкера вместе с ботом. Выключен: бумажный прогон пока
# не дал исполнений, и включать по умолчанию непроверенное неправильно.
PM_AUTOSTART=0
