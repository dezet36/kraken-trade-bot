# .env замороженного движка (/opt/copier/engine_data/.env, chmod 600).
#
# setup_server.sh и engine_update.sh --with-settings собирают его так:
#   1) настройки стратегий из .env торгового бота — СНИМКОМ на момент заморозки,
#      без секретов (ключи бирж, Telegram, модель, панель, платформа);
#   2) поверх — строки этого файла. Они главнее.
# Снимок не обновляется сам: настройки — такая же часть версии, как код.

# Бумажный режим: ордера на биржу физически не отправляются, ключей нет.
TRADING_MODE=PAPER
STRATEGY=BOTH
EXCHANGE_LIVE_ENABLED=false

# Telegram выключен: второй опросчик токена торгового бота сломал бы обоих.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Модель не нужна и не дана: её единственный слот занят торговым ботом.
# LLM_MODE=rules — стратегия ИИ работает по правилам без модели (участникам
# она всё равно не идёт). Адрес-заглушка: случайный вызов модели падает сразу,
# а не поднимает модель в память этого процесса.
LLM_MODE=rules
LLM_SHADOW=0
LLM_CRITIC=0
LLM_SERVER_URL=http://127.0.0.1:9
LLM_MODEL_PATH=

# Панель движка — только на петле и без управления; порт не тот, что у бота.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8791
DASHBOARD_ALLOW_CONTROL=false
