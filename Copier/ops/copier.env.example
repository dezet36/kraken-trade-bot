# .env копировщика (/opt/copier/data/.env, chmod 600, владелец copier).
# setup_server.sh создаёт его сам и генерирует секреты; руками вписать нужно
# только COPIER_TG_TOKEN (бот участников из @BotFather — НЕ токен торгового бота).

COPIER_TG_TOKEN=
COPIER_ADMIN_IDS=
# Ссылка регистрации на Upscale, которую бот даёт новому пользователю на /start.
COPIER_SIGNUP_URL=https://app.upscale.trade
# Мастер-ключ шифрования ключей участников. Потерять = все ключи нечитаемы.
# Сохраните копию отдельно (менеджер паролей): в резервную копию базы он не входит.
COPIER_SECRET_KEY=
COPIER_ADMIN_TOKEN=

# Запас до лимитов просадки пропа, % от номинала.
COPIER_DD_BUFFER_PCT=0.5

# Источник сделок — книга торгового счёта бота (только чтение, localhost).
COPIER_SOURCE_URL=http://127.0.0.1:8787/api/accounts/feed
COPIER_SOURCE_ACCOUNT=upscale
# Опрос книги и сверка со счетами Upscale, секунды. Риск на сделку — из правил счёта в боте.
COPIER_FEED_POLL_S=3
COPIER_RECONCILE_S=10
