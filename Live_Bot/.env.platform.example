# ════════════════════════════════════════════════════════════════════════════
#  ШАБЛОН КОНФИГУРАЦИИ ПЛАТФОРМЫ (мульти-юзер SaaS).
#  Скопируй в .env и заполни своими значениями. Файл .env в git НЕ попадает.
#  Запуск платформы:  python platform_bot.py
# ════════════════════════════════════════════════════════════════════════════

# ── Режим торговли ───────────────────────────────────────────────────────────
# DEMO — сначала ОБЯЗАТЕЛЬНО протестируй на демо-счетах. LIVE — реальные деньги юзеров.
TRADING_MODE=DEMO
EXCHANGE=bybit

# ── Telegram-бот (через него общаются пользователи) ─────────────────────────
# Создать бота: @BotFather -> /newbot -> скопировать токен.
TELEGRAM_BOT_TOKEN=123456:ABC-ваш_токен_бота

# ── Мастер-ключ шифрования API-ключей юзеров (КРИТИЧНО) ──────────────────────
# Сгенерировать (ОДИН раз) и НИКОМУ не показывать; потеря = все юзеры переподключают биржу:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_SECRET_KEY=ВСТАВЬ_СГЕНЕРИРОВАННЫЙ_FERNET_КЛЮЧ

# ── Администраторы (доступ к /admin, /grant, /ban и т.д.) ────────────────────
# Свой числовой Telegram ID узнать у @userinfobot. Несколько — через запятую.
ADMIN_IDS=123456789

# ── Крипто-платежи (продление подписки) ─────────────────────────────────────
# Провайдер: nowpayments (если задан ключ) | mock (демо, оплата не подтверждается сама).
PAYMENT_PROVIDER=nowpayments
# Ключ API из личного кабинета NOWPayments (nowpayments.io -> Settings -> API keys):
NOWPAYMENTS_API_KEY=ВСТАВЬ_КЛЮЧ_NOWPAYMENTS
# Актив, в котором принимаешь оплату (примеры: usdttrc20, usdterc20, btc, ton):
PAYMENT_CURRENCY=usdttrc20
# Как часто опрашивать статус оплат (минуты):
PAYMENT_POLL_MINUTES=2

# ── Параметры платформы (можно менять и из Telegram: /settrial /setprice ...) ─
# Базовые значения подписки лежат в БД (settings); ниже — только частота цикла.
PLATFORM_CYCLE_MINUTES=5
# Путь к БД платформы (по умолчанию Live_Bot/platform.db):
# PLATFORM_DB=D:\Bot trade\Live_Bot\platform.db

# ── Риск (фиксирован платформой, применяется к КАЖДОМУ юзеру) ────────────────
RISK_PER_TRADE=0.5
MAX_ACTIVE_PAIRS=3
LEVERAGE=20

# ── (Опционально) ключи для legacy одно-юзерного bot.py — платформе НЕ нужны ──
# BYBIT_API_KEY=
# BYBIT_SECRET_KEY=
# BINGX_API_KEY=
# BINGX_SECRET_KEY=
